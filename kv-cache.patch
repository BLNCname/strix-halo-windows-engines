new file mode 100644
index 0000000..571a600
--- /dev/null
+++ b/src/models/qwen38_flash_next/kv_format.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+namespace gufo::models::qwen38_flash_next {
+enum class KvType : std::uint8_t { F16, Q8_0, Q4_0 };
+struct KvPair {
+  KvType k, v;
+};
+struct KvFormats {
+  KvPair target, draft;
+};
+
+inline const char* KvName(KvType kind) {
+  switch (kind) {
+    case KvType::Q8_0: return "q8_0";
+    case KvType::Q4_0: return "q4_0";
+    default: return "f16";
+  }
+}
+
+inline KvType ReadKvType(const char* key, KvType fallback) {
+  const char* value = std::getenv(key);
+  if (!value || !*value) return fallback;
+  for (const auto type : {KvType::F16, KvType::Q8_0, KvType::Q4_0}) {
+    if (std::string_view(value) == KvName(type)) return type;
+  }
+  throw std::invalid_argument(std::string(key) + " supports f16, q8_0 and q4_0");
+}
+
+inline const KvFormats& FlashKvFormats() {
+  static const KvFormats formats = [] {
+    KvPair target{ReadKvType("GUFO_FLASH_CACHE_K", KvType::F16),
+                  ReadKvType("GUFO_FLASH_CACHE_V", KvType::F16)};
+    return KvFormats{target, {ReadKvType("GUFO_FLASH_DRAFT_CACHE_K", target.k),
+                              ReadKvType("GUFO_FLASH_DRAFT_CACHE_V", target.v)}};
+  }();
+  return formats;
+}
+
+inline std::size_t KvRowBytes(KvType type, std::size_t width) {
+  if (type == KvType::F16) return width * 2;
+  if (width % 32 != 0) throw std::invalid_argument("Quantized KV requires 32-aligned rows");
+  return width / 32 * (type == KvType::Q8_0 ? 34 : 18);
+}
+
+inline unsigned KvFormatId(bool mtp) {
+  const auto& f = FlashKvFormats();
+  return unsigned(f.target.k) | (unsigned(f.target.v) << 2) |
+         (mtp ? (unsigned(f.draft.k) << 4) | (unsigned(f.draft.v) << 6) : 0);
+}
+} // namespace gufo::models::qwen38_flash_next
