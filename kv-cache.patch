diff --git a/src/models/qwen38_flash_next/kernels/rocm/kv_codec.hpp b/src/models/qwen38_flash_next/kernels/rocm/kv_codec.hpp
new file mode 100644
index 0000000..6a7f53c
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/kv_codec.hpp
@@ -0,0 +1,68 @@
+// Device storage uses the GGML Q8_0 and Q4_0 block layouts.
+template <KvType kind>
+__global__ void PackCacheRows(const __half* source, void* output,
+                              unsigned width, unsigned rows, const unsigned* pos) {
+  constexpr unsigned bytes = kind == KvType::Q8_0 ? 34 : 18;
+  const unsigned local = blockIdx.x * blockDim.x + threadIdx.x;
+  const unsigned lane = threadIdx.x & 31;
+  if (local >= width * rows) return;
+  const size_t i = size_t(pos ? *pos : 0) * width + local;
+  const float x = __half2float(source[i]);
+  float amax = fabsf(x);
+  for (int dist = 16; dist; dist >>= 1)
+    amax = fmaxf(amax, __shfl_xor(amax, dist, 32));
+  float scale;
+  if constexpr (kind == KvType::Q8_0) {
+    // Match the reference FP32 scale and reciprocal even with HIP fast-math.
+    scale = __fdiv_rn(amax, 127.0f);
+    asm volatile("" : "+v"(scale));
+  } else {
+    unsigned first = fabsf(x) == amax ? lane : 32;
+    for (int dist = 16; dist; dist >>= 1)
+      first = min(first, __shfl_xor(first, dist, 32));
+    scale = __shfl(x, first, 32) / -8.0f;
+  }
+  auto* block = static_cast<unsigned char*>(output) + (i / 32) * bytes;
+  if (lane == 0) *reinterpret_cast<__half*>(block) = __float2half(scale);
+  float inverse = scale != 0.0f ? __fdiv_rn(1.0f, scale) : 0.0f;
+  asm volatile("" : "+v"(inverse));
+  const float scaled = __fmul_rn(x, inverse);
+  if constexpr (kind == KvType::Q8_0) {
+    // Products of a binary16 magnitude and these small integers are exact in
+    // FP32. Compare the midpoint explicitly, including ties away from zero.
+    const int lower = min(127, static_cast<int>(fabsf(scaled)));
+    const int magnitude = amax == 0 ? 0 : min(127, lower + (fabsf(x) * 254.0f >= amax * (2 * lower + 1)));
+    reinterpret_cast<signed char*>(block + 2)[lane] =
+        static_cast<signed char>(x < 0 ? -magnitude : magnitude);
+  } else {
+    const unsigned code = static_cast<unsigned>(fmaxf(0, fminf(15, floorf(scaled + 8.5f))));
+    const unsigned high = __shfl_xor(code, 16, 32);
+    if (lane < 16) block[2 + lane] = static_cast<unsigned char>(code | (high << 4));
+  }
+}
+
+__device__ __forceinline__ uint4 LoadCacheEight(const __half* base, size_t i, KvType kind) {
+  if (kind == KvType::F16) return *reinterpret_cast<const uint4*>(base + i);
+  const bool q8 = kind == KvType::Q8_0;
+  const auto* block = reinterpret_cast<const unsigned char*>(base) + (i / 32) * (q8 ? 34 : 18);
+  const float scale = __half2float(*reinterpret_cast<const __half*>(block));
+  const unsigned offset = static_cast<unsigned>(i & 31);
+  uint4 result{};
+#pragma unroll
+  for (unsigned j = 0; j < 8; ++j) {
+    const unsigned lane = offset + j;
+    const int code = q8 ? int(reinterpret_cast<const signed char*>(block + 2)[lane])
+                        : int((block[2 + (lane & 15)] >> (lane >= 16 ? 4 : 0)) & 15) - 8;
+    reinterpret_cast<__half*>(&result)[j] = __float2half(scale * code);
+  }
+  return result;
+}
+
+__global__ void ExpandCachePrefix(const __half* packed, __half* output,
+                                  KvType kind, unsigned width, unsigned rows, const unsigned* pos) {
+  const size_t end = size_t((pos ? *pos : 0) + rows) * width / 8;
+  for (size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x; i < end;
+       i += size_t(gridDim.x) * blockDim.x) {
+    reinterpret_cast<uint4*>(output)[i] = LoadCacheEight(packed, i * 8, kind);
+  }
+}
