+
+struct SharedUsage {
+  std::atomic<std::uint32_t> rows{0}, peak_rows{0};
+  std::atomic<std::uint64_t> mapped_bytes{0};
+};
+inline SharedUsage& Usage() {
+  static SharedUsage usage;
+  return usage;
+}
+
+inline LoadSettings& Load() {
+  static LoadSettings settings;
