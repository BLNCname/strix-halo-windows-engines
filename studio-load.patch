--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/shared_kv.hpp
@@ -0,0 +1,174 @@
+#pragma once
+
+#include <hip/hip_fp16.h>
+#include <hip/hip_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "src/core/studio_load.hpp"
+
+namespace gufo::models::qwen38_flash_next::rocm {
+
+// Each slot has stable virtual addresses for captured HIP graphs. The common
+// budget charges token rows; physical mappings grow only for rows a slot uses.
+class SharedKvBudget {
+public:
+  explicit SharedKvBudget(std::uint32_t tokens) : limit(tokens) {
+    props.type = hipMemAllocationTypePinned;
+    props.location.type = hipMemLocationTypeDevice;
+    Check(hipGetDevice(&props.location.id));
+    Check(hipMemGetAllocationGranularity(&granularity, &props,
+                                         hipMemAllocationGranularityMinimum));
+  }
+  void Claim(std::uint32_t n) {
+    std::lock_guard lock(mutex);
+    if (n > limit - used)
+      throw std::length_error("shared KV context is full (" +
+                              std::to_string(used) + " of " +
+                              std::to_string(limit) + " token rows in use)");
+    used += n;
+    studio::Usage().rows.store(used);
+    if (used > studio::Usage().peak_rows.load())
+      studio::Usage().peak_rows.store(used);
+  }
+  void GiveBack(std::uint32_t n) noexcept {
+    std::lock_guard lock(mutex);
+    used -= n;
+    studio::Usage().rows.store(used);
+  }
+  std::size_t Align(std::size_t n) const {
+    return (n + granularity - 1) / granularity * granularity;
+  }
+  static void Check(hipError_t rc) {
+    if (rc != hipSuccess)
+      throw std::runtime_error(std::string("shared HIP KV allocation: ") +
+                               hipGetErrorString(rc));
+  }
+  const std::uint32_t limit;
+  hipMemAllocationProp props{};
+  std::size_t granularity{};
+
+private:
+  std::mutex mutex;
+  std::uint32_t used{0};
+};
+
+class SharedKvSlot {
+  struct Mapping {
+    std::size_t offset, bytes;
+    hipMemGenericAllocationHandle_t handle;
+  };
+  struct Range {
+    void* address{};
+    std::size_t row_bytes{}, span{}, committed{};
+    std::vector<Mapping> mappings;
+  };
+
+public:
+  SharedKvSlot(std::shared_ptr<SharedKvBudget> budget, std::uint32_t capacity)
+      : budget_(std::move(budget)), capacity_(capacity) {}
+  SharedKvSlot(const SharedKvSlot&) = delete;
+  SharedKvSlot& operator=(const SharedKvSlot&) = delete;
+  ~SharedKvSlot() {
+    if (rows_)
+      (void)hipDeviceSynchronize();
+    Clear();
+    for (auto& col : columns_)
+      if (col.address)
+        (void)hipMemAddressFree(col.address, col.span);
+  }
+  __half* Column(std::size_t row_bytes) {
+    auto& r = columns_.emplace_back();
+    r.row_bytes = row_bytes;
+    r.span = budget_->Align(row_bytes * capacity_);
+    SharedKvBudget::Check(
+        hipMemAddressReserve(&r.address, r.span, 0, nullptr, 0));
+    return static_cast<__half*>(r.address);
+  }
+  void Ensure(std::uint32_t end) {
+    if (end <= rows_)
+      return;
+    if (end > capacity_)
+      throw std::length_error("KV write exceeds per-session capacity");
+    const auto delta = end - rows_;
+    budget_->Claim(delta);
+    const auto target = std::min(capacity_, ((end - 1) / 2048 + 1) * 2048u);
+    if (target > backed_rows_) {
+      try {
+        for (auto& r : columns_)
+          Extend(r, budget_->Align(r.row_bytes * target));
+      } catch (...) {
+        for (auto& r : columns_)
+          Trim(r, budget_->Align(r.row_bytes * backed_rows_));
+        budget_->GiveBack(delta);
+        throw;
+      }
+      backed_rows_ = target;
+    }
+    rows_ = end;
+  }
+  void Reset() {
+    if (rows_)
+      SharedKvBudget::Check(hipDeviceSynchronize());
+    Clear();
+  }
+  std::size_t Bytes() const {
+    std::size_t bytes = 0;
+    for (const auto& r : columns_)
+      bytes += r.committed;
+    return bytes;
+  }
+
+private:
+  void Extend(Range& r, std::size_t end) {
+    if (end <= r.committed)
+      return;
+    r.mappings.reserve(r.mappings.size() + 1);
+    const auto bytes = end - r.committed;
+    auto* at = static_cast<std::uint8_t*>(r.address) + r.committed;
+    hipMemGenericAllocationHandle_t handle{};
+    SharedKvBudget::Check(hipMemCreate(&handle, bytes, &budget_->props, 0));
+    auto rc = hipMemMap(at, bytes, 0, handle, 0);
+    if (rc == hipSuccess) {
+      hipMemAccessDesc access{budget_->props.location,
+                              hipMemAccessFlagsProtReadWrite};
+      rc = hipMemSetAccess(at, bytes, &access, 1);
+      if (rc != hipSuccess)
+        (void)hipMemUnmap(at, bytes);
+    }
+    if (rc != hipSuccess) {
+      (void)hipMemRelease(handle);
+      SharedKvBudget::Check(rc);
+    }
+    r.mappings.push_back({r.committed, bytes, handle});
+    r.committed = end;
+    studio::Usage().mapped_bytes.fetch_add(bytes);
+  }
+  static void Trim(Range& r, std::size_t keep) noexcept {
+    while (!r.mappings.empty() && r.mappings.back().offset >= keep) {
+      const auto m = r.mappings.back();
+      (void)hipMemUnmap(static_cast<std::uint8_t*>(r.address) + m.offset,
+                        m.bytes);
+      (void)hipMemRelease(m.handle);
+      r.committed = m.offset;
+      studio::Usage().mapped_bytes.fetch_sub(m.bytes);
+      r.mappings.pop_back();
+    }
+  }
+  void Clear() noexcept {
+    for (auto& r : columns_)
+      Trim(r, 0);
+    budget_->GiveBack(rows_);
+    rows_ = backed_rows_ = 0;
+  }
+  std::shared_ptr<SharedKvBudget> budget_;
+  std::vector<Range> columns_;
+  std::uint32_t capacity_, rows_{0}, backed_rows_{0};
+};
+}  // namespace gufo::models::qwen38_flash_next::rocm
