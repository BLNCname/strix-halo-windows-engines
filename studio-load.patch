diff --git a/src/cli/studio_launch.hpp b/src/cli/studio_launch.hpp
new file mode 100644
index 0000000..3121da0
--- /dev/null
+++ b/src/cli/studio_launch.hpp
@@ -0,0 +1,278 @@
+#pragma once
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <limits>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "src/core/platform/env.hpp"
+#include "src/core/studio_load.hpp"
+
+namespace gufo::cli {
+// Receives the model-launch argv emitted by the host, including one-off
+// overrides. Transport credentials terminate in the local API bridge, before
+// this entry point.
+inline std::vector<std::string> StudioArguments(
+    std::span<const char* const> input) {
+  if (input.size() < 7 || std::string_view(input[5]) != "--")
+    throw std::invalid_argument(
+        "usage: gufo serve lmstudio WORKER_PORT ALIAS -- MODEL_OPTIONS...");
+  using S = std::string;
+  auto number = [](const S& value, const S& key, int lo, int hi) {
+    int n{};
+    const auto [stop, err] =
+        std::from_chars(value.data(), value.data() + value.size(), n);
+    if (err != std::errc{} || stop != value.data() + value.size() || n < lo ||
+        n > hi)
+      throw std::invalid_argument("out of range or invalid integer for " + key);
+    return n;
+  };
+  auto real = [](const S& value, const S& key, float lo, float hi) {
+    std::size_t end = 0;
+    const float n = std::stof(value, &end);
+    if (end != value.size() || !std::isfinite(n) || n < lo || n > hi)
+      throw std::invalid_argument("out of range or invalid number for " + key);
+    return n;
+  };
+  auto unsupported = [](const S& key, const S& reason) {
+    throw std::invalid_argument(key + ": " + reason);
+  };
+  number(input[3], "worker port", 1, 65535);
+  auto& cfg = studio::Load();
+  cfg.active = true;
+  std::vector<S> out{
+      input[0],    "serve",         "llm",    "--host",
+      "127.0.0.1", "--port",        input[3], "--served-model-name",
+      input[4],    "--log-progress"};
+  std::vector<S> received;
+  bool unified = false, have_model = false;
+  unsigned total = 0, sessions = 1, per_slot = 0;
+  S mode, draft, ktype = "f16", vtype = "f16", draft_k, draft_v;
+  S ram_cache;
+  for (std::size_t i = 6; i < input.size(); ++i) {
+    S raw(input[i]);
+    const auto eq = raw.find('=');
+    S key = raw.substr(0, eq);
+    auto take = [&]() -> S {
+      if (eq != S::npos)
+        return raw.substr(eq + 1);
+      if (++i == input.size() || std::string_view(input[i]).starts_with("--"))
+        throw std::invalid_argument("missing value for " + key);
+      return input[i];
+    };
+    auto integer = [&](int lo, int hi) { return number(take(), key, lo, hi); };
+    auto decimal = [&](float lo, float hi) {
+      return real(take(), key, lo, hi);
+    };
+    if (key.starts_with("-"))
+      received.push_back(key);
+    if (key == "--ctx-size" || key == "-c")
+      total = integer(0, 16777216);
+    else if (key == "--parallel" || key == "-np")
+      sessions = integer(1, 64);
+    else if (key == "--kv-unified" || key == "-kvu")
+      unified = true;
+    else if (key == "--no-kv-unified" || key == "-no-kvu")
+      unified = false;
+    else if (key == "--kv-unified-per-slot")
+      per_slot = integer(1, 16777216);
+    else if (key == "--model" || key == "-m") {
+      out.insert(out.end(), {"--model", take()});
+      have_model = true;
+    } else if (key == "--host" || key == "--port")
+      (void)take();
+    else if (key == "--alias" || key == "-a") {
+      const S aliases = take();
+      for (size_t begin = 0; begin < aliases.size();) {
+        const auto end = aliases.find(',', begin);
+        auto alias = aliases.substr(begin, end == S::npos ? end : end - begin);
+        if (!alias.empty() && alias != input[4])
+          out.insert(out.end(), {"--served-model-name", alias});
+        if (end == S::npos)
+          break;
+        begin = end + 1;
+      }
+    } else if (key == "--no-webui" || key == "--jinja" ||
+               key == "--kv-offload" || key == "--op-offload" ||
+               key == "--mmproj-offload" ||
+               key == "--cont-batching") { /* native service topology */
+    } else if (key == "--gpu-layers" || key == "--n-gpu-layers" ||
+               key == "-ngl") {
+      const auto value = take();
+      if (value != "all" && value != "auto" && value != "-1" &&
+          number(value, key, 0, 2147483647) < 48)
+        unsupported(key, "Flash-Next requires all 48 trunk layers on the GPU");
+    } else if (key == "--n-cpu-moe" || key == "--n-cpu-moe-draft") {
+      if (integer(0, 2147483647) != 0)
+        unsupported(
+            key,
+            "CPU expert offload is unavailable on this native ROCm worker");
+    } else if (key == "--main-gpu" || key == "-mg") {
+      if (integer(0, 64) != 0)
+        unsupported(key, "the Strix Halo worker uses device 0");
+    } else if (key == "--tensor-split" || key == "-ts") {
+      const auto v = take();
+      if (v.find_first_of(",/") != S::npos)
+        unsupported(key, "multiple devices are unavailable");
+      (void)real(v, key, 0, std::numeric_limits<float>::max());
+    } else if (key == "--split-mode" || key == "-sm") {
+      const auto v = take();
+      if (v != "layer" && v != "none")
+        unsupported(key, "only a single Strix Halo GPU is available");
+    } else if (key == "--no-kv-offload")
+      unsupported(key, "this worker keeps the attention cache on the GPU");
+    else if (key == "--threads" || key == "-t" || key == "--threads-batch" ||
+             key == "-tb") {
+      const int n = integer(-1, 1024);
+      if (n > 0) {
+        if (key == "--threads-batch" || key == "-tb")
+          cfg.batch_threads = n;
+        else
+          cfg.threads = n;
+      }
+    } else if (key == "--batch-size" || key == "-b")
+      cfg.batch = integer(1, 1048576);
+    else if (key == "--ubatch-size" || key == "-ub")
+      cfg.ubatch = integer(1, 1048576);
+    else if (key == "--ctx-checkpoints")
+      cfg.checkpoints = integer(0, 128);
+    else if (key == "--flash-attn" || key == "-fa") {
+      const auto v = take();
+      if (v != "on" && v != "auto" && v != "off")
+        unsupported(key, "expected on, off or auto");
+      cfg.flash_attention = v != "off";
+    } else if (key == "--cache-type-k" || key == "-ctk")
+      ktype = take();
+    else if (key == "--cache-type-v" || key == "-ctv")
+      vtype = take();
+    else if (key == "--spec-draft-type-k" || key == "--cache-type-k-draft" ||
+             key == "-ctkd")
+      draft_k = take();
+    else if (key == "--spec-draft-type-v" || key == "--cache-type-v-draft" ||
+             key == "-ctvd")
+      draft_v = take();
+    else if (key == "--spec-type")
+      mode = take();
+    else if (key == "--spec-draft-model" || key == "--model-draft" ||
+             key == "-md")
+      draft = take();
+    else if (key == "--spec-draft-n-max" || key == "--draft-max")
+      cfg.draft_max = integer(1, 7);
+    else if (key == "--spec-draft-n-min" || key == "--draft-min")
+      cfg.draft_min = integer(0, 7);
+    else if (key == "--spec-draft-p-min" || key == "--draft-p-min")
+      cfg.draft_probability = decimal(0, 1);
+    else if (key == "--chat-template-file")
+      cfg.chat_template = take();
+    else if (key == "--load-mode")
+      cfg.memory_mode = take();
+    else if (key == "--mmap")
+      cfg.memory_mode = "mmap";
+    else if (key == "--no-mmap")
+      cfg.memory_mode = "none";
+    else if (key == "--mlock")
+      cfg.memory_mode = "mlock";
+    else if (key == "--lazy-mode") {
+      const auto v = take();
+      if (v != "auto" && v != "off" && v != "on")
+        unsupported(key, "expected auto, on or off");
+      cfg.lazy_mode = v;
+    } else if (key == "--rope-freq-base")
+      cfg.rope_base = decimal(0, std::numeric_limits<float>::max());
+    else if (key == "--rope-freq-scale")
+      cfg.rope_scale = decimal(0, std::numeric_limits<float>::max());
+    else if (key == "--verbosity") {
+      const int v = integer(0, 9);
+      out.insert(out.end(), {"--log-level", v == 0   ? "error"
+                                            : v == 1 ? "warn"
+                                            : v >= 4 ? "debug"
+                                                     : "info"});
+    } else if (key == "--cache-ram-bytes")
+      ram_cache = take();
+    else if (key == "--reasoning" || key == "-rea")
+      out.insert(out.end(), {"--think", take()});
+    else if (key == "--temp")
+      out.insert(out.end(), {"--temperature", take()});
+    else if (key == "--api-key" || key == "--api-key-file")
+      unsupported(key, "transport authentication belongs to the host bridge");
+    else
+      out.push_back(raw);  // The native CLI accepts its own options or names an
+                           // unsupported one.
+  }
+  cfg.option_names = received;
+  cfg.sessions = sessions;
+  cfg.key_cache = ktype;
+  cfg.value_cache = vtype;
+  cfg.draft_key_cache = draft_k.empty() ? ktype : draft_k;
+  cfg.draft_value_cache = draft_v.empty() ? vtype : draft_v;
+  if (cfg.threads)
+    platform::SetEnv("OMP_NUM_THREADS", std::to_string(cfg.threads));
+  if (cfg.batch_threads || cfg.threads)
+    platform::SetEnv(
+        "RAYON_NUM_THREADS",
+        std::to_string(cfg.batch_threads ? cfg.batch_threads : cfg.threads));
+  if (!have_model)
+    throw std::invalid_argument("--model is required");
+  if (cfg.memory_mode != "" && cfg.memory_mode != "none" &&
+      cfg.memory_mode != "mmap" && cfg.memory_mode != "auto" &&
+      cfg.memory_mode != "dio" && cfg.memory_mode != "mlock" &&
+      cfg.memory_mode != "mmap+mlock")
+    unsupported("--load-mode",
+                "expected auto, none, mmap, mlock, mmap+mlock or dio");
+  if (cfg.draft_max && cfg.draft_min > cfg.draft_max)
+    unsupported("--spec-draft-n-min", "minimum exceeds maximum");
+  for (const auto& [name, value] : std::vector<std::pair<S, S>>{
+           {"GUFO_FLASH_CACHE_K", ktype},
+           {"GUFO_FLASH_CACHE_V", vtype},
+           {"GUFO_FLASH_DRAFT_CACHE_K", draft_k.empty() ? ktype : draft_k},
+           {"GUFO_FLASH_DRAFT_CACHE_V", draft_v.empty() ? vtype : draft_v}}) {
+    if (value != "q8_0" && value != "q4_0" && value != "f16")
+      unsupported(name, "supported cache types are q8_0, q4_0 and f16");
+    if (!platform::SetEnv(name, value))
+      throw std::runtime_error("failed to configure attention cache");
+  }
+  if (total == 0)
+    total = unified && per_slot ? per_slot * sessions : 262144u;
+  const unsigned context = unified
+                               ? (per_slot ? std::min(per_slot, total) : total)
+                               : total / sessions;
+  if (context < 2)
+    unsupported("--ctx-size", "effective session context is too short");
+  cfg.shared_context = unified ? total : 0;
+  out.insert(out.end(), {"--context", std::to_string(context), "--sessions",
+                         std::to_string(sessions), "--cache-ram-bytes",
+                         cfg.checkpoints == 0 ? "off"
+                         : !ram_cache.empty() ? ram_cache
+                         : context >= 1000000 ? "off"
+                                              : "6442450944"});
+  if (context > 262144)
+    out.push_back("--enable-yarn");
+  if (mode != "off" && mode != "none" && (!draft.empty() || !mode.empty())) {
+    if (mode != "" && mode != "mtp" && mode != "draft-mtp" &&
+        mode != "draft-simple")
+      unsupported("--spec-type", "this model implements external MTP");
+    if (draft.empty())
+      unsupported("--spec-draft-model", "select the separate MTP GGUF");
+    out.insert(out.end(), {"--speculative", "mtp", "--mtp-model", draft});
+  }
+  std::cerr << "[Studio load] argv:";
+  for (const auto& key : received)
+    std::cerr << " " << key;
+  std::cerr << "\n[Studio load] sessions=" << sessions << " context=" << context
+            << " shared_rows=" << cfg.shared_context << " batch=" << cfg.batch
+            << " ubatch=" << cfg.ubatch << " cpu_threads=" << cfg.threads
+            << " flash_attention=" << (cfg.flash_attention ? "on" : "off")
+            << " checkpoints=" << cfg.checkpoints << " target_k=" << ktype
+            << " target_v=" << vtype << " draft_max=" << cfg.draft_max
+            << " draft_min=" << cfg.draft_min
+            << " draft_p_min=" << cfg.draft_probability << "\n";
+  return out;
+}
+}  // namespace gufo::cli
