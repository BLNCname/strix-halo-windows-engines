+template<UploadConversion conversion>
+__global__ void ConvertMixedWeightsKernel(const std::uint8_t* src, void* dst,
+                                          std::size_t count) {
+  const std::size_t i = std::size_t{blockIdx.x} * blockDim.x + threadIdx.x;
+  if (i >= count)
+    return;
+  if constexpr (conversion == UploadConversion::kExpertQ2) {
+    // Each input block shares one FP16 scale across 64 two-bit codes.
+    const auto* block = src + (i / 64) * 18;
+    auto* q8 = static_cast<std::uint8_t*>(dst) + (i / 32) * 34;
+    if ((i % 32) == 0)
+      *reinterpret_cast<std::uint16_t*>(q8) =
+          *reinterpret_cast<const std::uint16_t*>(block);
+    const unsigned code = (block[2 + (i % 64) / 4] >> (2 * (i % 4))) & 3;
+    reinterpret_cast<std::int8_t*>(q8 + 2)[i % 32] = static_cast<int>(code) - 1;
+  } else {
+    const unsigned j = i % 256;
+    float weight;
+    if constexpr (conversion == UploadConversion::kDenseQ6) {
+      const auto* block = src + (i / 256) * 210;
+      const unsigned half = j / 128, lane = j % 32, segment = (j / 32) % 4;
+      const unsigned lo = (block[half * 64 + (segment % 2) * 32 + lane] >>
+                           (4 * (segment / 2))) &
+                          15;
+      const unsigned hi = (block[128 + half * 32 + lane] >> (2 * segment)) & 3;
+      const int scale =
+          reinterpret_cast<const std::int8_t*>(block + 192)[j / 16];
+      weight = __half2float(*reinterpret_cast<const __half*>(block + 208)) *
+               scale * (static_cast<int>(lo | (hi << 4)) - 32);
+    } else {
+      constexpr std::int8_t values[] = {-127, -104, -83, -65, -49, -35,
+                                        -22,  -10,  1,   13,  25,  38,
+                                        53,   69,   89,  113};
+      const auto* block = src + (i / 256) * 136;
+      const unsigned g = j / 32;
+      const unsigned lo = (block[4 + g / 2] >> (4 * (g % 2))) & 15;
+      const unsigned hi =
+          (*reinterpret_cast<const std::uint16_t*>(block + 2) >> (2 * g)) & 3;
+      const unsigned code =
+          (block[8 + g * 16 + j % 16] >> (4 * ((j / 16) % 2))) & 15;
+      weight = __half2float(*reinterpret_cast<const __half*>(block)) *
+               (static_cast<int>(lo | (hi << 4)) - 32) * values[code];
+    }
+    static_cast<__half*>(dst)[i] = __float2half_rn(weight);
+  }
+}
