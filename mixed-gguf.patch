+void ConvertMixedWeights(UploadConversion conversion, const void* src,
+                         void* dst, std::size_t count, hipStream_t stream) {
+  const auto* bytes = static_cast<const std::uint8_t*>(src);
+  switch (conversion) {
+    case UploadConversion::kDenseQ6:
+      ConvertMixedWeightsKernel<UploadConversion::kDenseQ6>
+          <<<Blocks(count), kThreads, 0, stream>>>(bytes, dst, count);
+      break;
+    case UploadConversion::kEmbedIQ4:
+      ConvertMixedWeightsKernel<UploadConversion::kEmbedIQ4>
+          <<<Blocks(count), kThreads, 0, stream>>>(bytes, dst, count);
+      break;
+    case UploadConversion::kExpertQ2:
+      ConvertMixedWeightsKernel<UploadConversion::kExpertQ2>
+          <<<Blocks(count), kThreads, 0, stream>>>(bytes, dst, count);
+      break;
+    default:
